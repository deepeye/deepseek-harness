# Copy to .env and fill in. docker compose reads this file for both variable
# interpolation and the container's environment.

# Required by docker compose. The host's LAN address (IP preferred, or a
# hostname the other machines resolve). Browsers reach the Web UI at
# http://$LAN_HOST:3080/.
# Not named DSH_HOST: the CLI refuses DSH_* names in a .env it loads, and this
# file sits in the directory `pnpm dsh web` runs from.
LAN_HOST=192.168.1.10

# Optional. Leave empty to enter the key on the Web Models page instead; stored
# credentials live in ./data and take precedence over this variable.
DEEPSEEK_API_KEY=

# Optional. Custom API base URL for a gateway or proxy.
# DEEPSEEK_BASE_URL=
